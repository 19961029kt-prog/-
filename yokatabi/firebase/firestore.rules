rules_version = '2';

// Q-TRIP の Security Rules。
// 方針：書いていないことはすべて禁止。
// - profiles：遊ぶ人の登録（手帖に載せる名前・プライバシーポリシーへの同意・投稿の時刻）。本人だけが読める。
// - privateStats：統計用の登録（年代・性別・出身地・現在の所在地）。本人だけが読み書きできる（運営もアプリからは読まない。
//   集計は運営が Firebase コンソールで、少ない人数から人が特定されないようにまとめて行う）。
// - メールアドレスは Firebase Authentication の中だけにあり、どのコレクションにも入れない（入れられる項目をルールで限定している）。
// - saves：遊んだ記録（端末の localStorage と同じ JSON）。本人だけが読み書きできる。
// - voicesPending → voices：ログインした人が「地元の人」として紹介するおすすめスポット。審査待ちと承認済みを別のコレクションに分け、
//   承認済みは「投稿された文面そのまま」しか載せられない（運営も書き換えられない）。
// App Check はここでは見えないので、Firebase コンソールで Firestore と Authentication の「適用（Enforce）」を必ず有効にする。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // ゲームで遊ぶ人：メールアドレスが確かめられた人（Google・メールリンク。匿名は不可）
    function isPlayer() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function docPath(col, id) {
      return /databases/$(database)/documents/$(col)/$(id);
    }
    // 運営（審査する人）：admins/{uid} があるかどうか。admins はコンソールからしか作れない
    function isAdmin() {
      return signedIn() && exists(docPath('admins', request.auth.uid));
    }
    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    // ゲームの26駅だけ（stations.json の id。駅を足したらここにも足す）
    function isGameStation(v) {
      return v in ['hakata', 'mojiko', 'dazaifu', 'saga', 'karatsu', 'ureshino-onsen', 'arita', 'nagasaki', 'huis-ten-bosch',
        'shimabara', 'kumamoto', 'aso', 'kurokawa-onsen', 'hitoyoshi', 'misumi', 'beppu', 'yufuin', 'hita', 'miyazaki',
        'takachiho', 'aoshima', 'kagoshima-chuo', 'kirishima-onsen', 'sakurajima', 'ibusuki', 'yakushima'];
    }
    // 国は ISO 3166-1 の2文字。日本（JP）のときだけ都道府県（01〜47 の JIS コード）が要る。日本以外は空
    function isPlace(country, pref) {
      return country is string && country.matches('^[A-Z]{2}$') && pref is string
        && (country == 'JP' ? pref.matches('^(0[1-9]|[1-3][0-9]|4[0-7])$') : pref == '');
    }

    // ---------- 運営（クライアントからは誰も書けない） ----------
    match /admins/{uid} {
      // 自分が運営かどうかを画面が知るためだけに、本人の1件だけ読める
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // いまのプライバシーポリシーの版（js/privacy.js の VERSION と同じにする。上げたら、次にひらいたときに同意し直してもらう）
    function policyVersion() {
      return 1;
    }

    // ---------- 遊ぶ人の登録（名前と同意だけ。メールアドレスなど、書いていない項目は入れられない） ----------
    match /profiles/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['displayName', 'createdAt', 'lastPostAt', 'policyVersion', 'agreedAt'])
          && d.keys().hasAll(['displayName', 'createdAt', 'policyVersion', 'agreedAt'])
          && isText(d.displayName, 1, 40)
          && d.policyVersion == policyVersion()
          && d.createdAt is timestamp && d.agreedAt is timestamp
          && (!('lastPostAt' in d) || d.lastPostAt is timestamp);
      }
      // 読めるのは本人だけ（ほかの人に見える名前は、投稿に写したものだけ。運営もアプリからは読まない）
      allow get: if isPlayer() && request.auth.uid == uid;
      allow list: if false;
      // 本人だけが書ける。登録した時刻と同意した時刻は「今」。登録日はあとから変えられない。
      // lastPostAt は「今」以外にできない（過去にして連投の歯止めをすり抜けないように）
      allow create: if isPlayer() && request.auth.uid == uid && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.agreedAt == request.time
        && !('lastPostAt' in request.resource.data);
      allow update: if isPlayer() && request.auth.uid == uid && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.agreedAt == resource.data.get('agreedAt', null) || request.resource.data.agreedAt == request.time)
        && (request.resource.data.get('lastPostAt', null) == resource.data.get('lastPostAt', null)
            || request.resource.data.lastPostAt == request.time);
      // 退会（登録と記録を消す）：本人はいつでも消せる
      allow delete: if isPlayer() && request.auth.uid == uid;
    }

    // ---------- 統計用の登録（年代・性別・出身地・現在の所在地）：本人だけが読み書きできる ----------
    match /privateStats/{uid} {
      function validStats(d) {
        return d.keys().hasOnly(['ageGroup', 'gender', 'homeCountry', 'homePref', 'liveCountry', 'livePref', 'updatedAt'])
          && d.keys().hasAll(['ageGroup', 'gender', 'homeCountry', 'homePref', 'liveCountry', 'livePref', 'updatedAt'])
          && d.ageGroup in ['10s', '20s', '30s', '40s', '50s', '60s', '70plus']
          && d.gender in ['female', 'male', 'other', 'noanswer']
          && isPlace(d.homeCountry, d.homePref)
          && isPlace(d.liveCountry, d.livePref)
          && d.updatedAt == request.time;
      }
      allow get: if isPlayer() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isPlayer() && request.auth.uid == uid && validStats(request.resource.data);
      allow delete: if isPlayer() && request.auth.uid == uid;
    }

    // ---------- 遊んだ記録（本人だけ） ----------
    match /saves/{uid} {
      function validSave(d) {
        return d.keys().hasOnly(['data', 'version', 'progress', 'savedAt', 'updatedAt'])
          && d.keys().hasAll(['data', 'version', 'progress', 'savedAt', 'updatedAt'])
          && d.data is string && d.data.size() <= 400000   // 記録の JSON（写真は入れない。1MB の上限よりずっと小さく）
          && d.version is int && d.version >= 1 && d.version <= 99
          && d.progress is int && d.progress >= 0
          && d.savedAt is int                              // 端末で最後に保存した時刻（ミリ秒）。どちらが新しいかを比べる
          && d.updatedAt == request.time;
      }
      allow get: if isPlayer() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isPlayer() && request.auth.uid == uid && validSave(request.resource.data);
      allow delete: if isPlayer() && request.auth.uid == uid;
    }

    // ---------- 駅ノート（地元の人の思い出の場所）：審査待ち（投稿した本人と運営だけが見られる） ----------
    match /voicesPending/{voiceId} {
      function profilePath() {
        return docPath('profiles', request.auth.uid);
      }
      function validNewVoice(d) {
        let p = get(profilePath()).data;
        let last = p.get('lastPostAt', timestamp.value(0));
        return d.keys().hasOnly(['uid', 'stationId', 'spot', 'body', 'name', 'bond', 'consent', 'createdAt'])
          && d.keys().hasAll(['uid', 'stationId', 'spot', 'body', 'name', 'bond', 'consent', 'createdAt'])
          && d.uid == request.auth.uid
          && isGameStation(d.stationId)
          && isText(d.spot, 1, 40)                // 思い出の場所
          && isText(d.body, 1, 400)               // そこでの思い出
          // この駅とのつながりは選択肢から（自由に書く欄にすると、学校名・勤め先など人が分かることが入りやすいため）
          && d.bond in ['commute', 'homecoming', 'everyday', 'detour']
          && d.name == p.displayName              // 名前は登録のとおり（なりすまし防止）
          && d.consent == true                    // 寄り道手帖への掲載に同意した
          && d.createdAt == request.time
          // 連投の歯止め：前の投稿から3分（推定の値）。同じ一括書き込みで登録の lastPostAt を今に更新していること
          && request.time > last + duration.value(180, 's')
          && getAfter(profilePath()).data.lastPostAt == request.time;
      }
      allow create: if isPlayer() && exists(profilePath()) && validNewVoice(request.resource.data);
      // 本人の分は、uid で絞った問い合わせでも読める
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // 審査中の書き換えは認めない（直したいときは取り下げて出し直す）
      allow update: if false;
      // 本人はいつでも取り下げられる。運営が消すとき（承認・却下）は、同じ一括書き込みで審査の記録を残すこと
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid)
        || (isAdmin() && existsAfter(docPath('moderationLog', voiceId)));
    }

    // ---------- 駅ノート：承認済み（だれでも読める） ----------
    match /voices/{voiceId} {
      // 承認は「審査待ちの文面をそのまま写す＋審査待ちを消す＋審査の記録を残す」を1回の一括書き込みで行う
      function approvedCopy(d) {
        let p = get(docPath('voicesPending', voiceId)).data;
        return d.keys().hasOnly(['uid', 'stationId', 'spot', 'body', 'name', 'bond', 'consent', 'createdAt', 'approvedAt', 'approvedBy'])
          && d.uid == p.uid && d.stationId == p.stationId && d.spot == p.spot && d.body == p.body
          && d.name == p.name && d.bond == p.bond && d.consent == p.consent && d.createdAt == p.createdAt
          && d.approvedAt == request.time
          && d.approvedBy == request.auth.uid;
      }
      allow get, list: if true;
      allow create: if isAdmin()
        && exists(docPath('voicesPending', voiceId))
        && !existsAfter(docPath('voicesPending', voiceId))
        && getAfter(docPath('moderationLog', voiceId)).data.action == 'approve'
        && approvedCopy(request.resource.data);
      allow update: if false;
      // 本人の取り下げ（同意の撤回）と、運営による削除
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- 審査の記録（あとから消せない・書き換えられない） ----------
    match /moderationLog/{voiceId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'by', 'at', 'reason'])
        && request.resource.data.action in ['approve', 'reject']
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && isText(request.resource.data.get('reason', ''), 0, 200);
      allow update, delete: if false;
    }

    // ---------- 旅の便り（写真のポストカード）：審査なしで、ログインした人どうしで見せ合う。通報が3件で自動で隠す ----------
    // 文書の id は「投函した人の uid _ 駅の id」（1人1駅1枚。投函し直すと差し替え）。写真は JPEG の data URL（50万字まで）
    match /postcards/{pid} {
      function isOwnerOf(d) {
        return signedIn() && d.uid == request.auth.uid;
      }
      function validCard(d) {
        return d.keys().hasOnly(['uid', 'stationId', 'memo', 'thumb', 'name', 'createdAt', 'updatedAt', 'likeCount', 'reportCount', 'hidden'])
          && d.keys().hasAll(['uid', 'stationId', 'memo', 'thumb', 'name', 'createdAt', 'updatedAt', 'likeCount', 'reportCount', 'hidden'])
          && pid == d.uid + '_' + d.stationId
          && isGameStation(d.stationId)
          && isText(d.memo, 0, 60)
          // 一覧に出す小さな写真だけ（6万字まで）。大きな写真は postcardImages に分けて、拡大したときだけ読む（読み込みの量とお金を抑える）
          && d.thumb is string && d.thumb.size() <= 60000 && d.thumb.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && d.likeCount is int && d.likeCount >= 0
          && d.reportCount is int && d.reportCount >= 0
          && d.hidden == (d.reportCount >= 3)
          && d.createdAt is timestamp && d.updatedAt is timestamp;
      }
      function nameOk(d) {
        return exists(docPath('profiles', request.auth.uid)) && d.name == get(docPath('profiles', request.auth.uid)).data.displayName;
      }
      // 見られるのは、ログインした人（隠れていないものだけ）・投函した本人・運営
      allow get: if isPlayer() && (resource.data.hidden == false || isOwnerOf(resource.data) || isAdmin());
      allow list: if (isPlayer() && resource.data.hidden == false) || isAdmin();
      // 投函：本人だけ。いいね・通報は0から。名前は登録のとおり
      // 大きな写真（postcardImages）も、同じ一括書き込みで作ること
      allow create: if isPlayer() && isOwnerOf(request.resource.data) && validCard(request.resource.data) && nameOk(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.likeCount == 0 && request.resource.data.reportCount == 0
        && existsAfter(docPath('postcardImages', pid));
      allow update: if isPlayer() && validCard(request.resource.data) && (
        // ① 本人の差し替え（写真・一言・名前）。いいね・通報・隠れ・投函日は変えられない。差し替えは30秒あける
        (isOwnerOf(resource.data) && nameOk(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memo', 'thumb', 'name', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.time > resource.data.updatedAt + duration.value(30, 's')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['thumb'])
              || getAfter(docPath('postcardImages', pid)).data.updatedAt == request.time))
        // ② ほかの人の「素敵ね」：いいねの数を1つだけ増やす。同じ一括書き込みで、その人のいいねの印を新しく作ること
        || (!isOwnerOf(resource.data) && resource.data.hidden == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && request.resource.data.likeCount == resource.data.likeCount + 1
          && !exists(/databases/$(database)/documents/postcards/$(pid)/likes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/postcards/$(pid)/likes/$(request.auth.uid)))
        // ③ ほかの人の通報：通報の数を1つだけ増やす（3件で隠れる）。同じ一括書き込みで、その人の通報を新しく作ること
        || (!isOwnerOf(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'hidden'])
          && request.resource.data.reportCount == resource.data.reportCount + 1
          && !exists(docPath('reports', request.auth.uid + '_' + pid))
          && existsAfter(docPath('reports', request.auth.uid + '_' + pid)))
        // ④ 運営が「問題なし」で戻す（通報を0にして見えるようにする）
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'hidden'])
          && request.resource.data.reportCount == 0)
      );
      allow delete: if isOwnerOf(resource.data) || isAdmin();

      // いいねの印（1人1回）。だれがいいねしたかは本人と運営だけが見られる
      match /likes/{likerUid} {
        allow get: if (signedIn() && request.auth.uid == likerUid) || isAdmin();
        allow list: if isAdmin();
        allow create: if isPlayer() && request.auth.uid == likerUid
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && get(docPath('postcards', pid)).data.uid != request.auth.uid
          && getAfter(docPath('postcards', pid)).data.likeCount == get(docPath('postcards', pid)).data.likeCount + 1;
        allow update, delete: if false;
      }
    }

    // ---------- 旅の便りの大きな写真（文書の id はポストカードと同じ。拡大したときだけ1枚読む） ----------
    match /postcardImages/{pid} {
      // 見られるのは、ポストカードが見える人だけ（隠れた写真は本人と運営だけ）。一覧で読むのは運営だけ
      allow get: if isAdmin() || (isPlayer() && exists(docPath('postcards', pid))
        && (get(docPath('postcards', pid)).data.hidden == false || get(docPath('postcards', pid)).data.uid == request.auth.uid));
      allow list: if isAdmin();
      // 書けるのは投函した本人だけで、ポストカードの作成・差し替えと同じ一括書き込みのときだけ（30秒あける決まりもポストカード側でかかる）
      allow create, update: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'image', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'image', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.image is string && request.resource.data.image.size() <= 500000
        && request.resource.data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedAt == request.time
        && getAfter(docPath('postcards', pid)).data.uid == request.auth.uid
        && getAfter(docPath('postcards', pid)).data.updatedAt == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- 旅の便りの通報（運営だけが読める。文書の id は「通報した人の uid _ ポストカードの id」で1人1回） ----------
    match /reports/{rid} {
      allow get, list: if isAdmin();
      allow create: if isPlayer()
        && rid == request.auth.uid + '_' + request.resource.data.postcardId
        && request.resource.data.keys().hasOnly(['postcardId', 'reporter', 'reason', 'note', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.reason in ['face', 'private', 'copyright', 'inappropriate', 'other']
        && isText(request.resource.data.note, 0, 200)
        && request.resource.data.createdAt == request.time
        && exists(docPath('postcards', request.resource.data.postcardId))
        && get(docPath('postcards', request.resource.data.postcardId)).data.uid != request.auth.uid
        && getAfter(docPath('postcards', request.resource.data.postcardId)).data.reportCount
           == get(docPath('postcards', request.resource.data.postcardId)).data.reportCount + 1;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- それ以外はすべて禁止（以前の地元の人の名簿 contributors も） ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
